# .htaccess - Performance & Security Configuration
# Add these rules to your root .htaccess file for optimal performance
# For WordPress, usually these are pre-configured by WordPress install

# ============================================
# ENABLE GZIP COMPRESSION
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
</IfModule>

# ============================================
# SET EXPIRES HEADERS (Browser Caching)
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Media Files
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/x-font-otf "access plus 1 year"
    
    # HTML and XML
    ExpiresByType text/html "access plus 2 days"
    ExpiresByType text/xml "access plus 2 days"
    ExpiresByType application/xml "access plus 2 days"
    
    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# ============================================
# CACHE CONTROL HEADERS
# ============================================
<IfModule mod_headers.c>
    # Static files - long term caching
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # HTML files - shorter cache
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=172800, public"
    </FilesMatch>
    
    # PHP files - no cache
    <FilesMatch "\.php$">
        Header set Cache-Control "max-age=0, must-revalidate, private"
    </FilesMatch>
</IfModule>

# ============================================
# PREVENT ACCESS TO SENSITIVE FILES
# ============================================
<FilesMatch "\.(env|htaccess|htpasswd|wp-config|php\.old)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================
# DISABLE DIRECTORY INDEXING
# ============================================
Options -Indexes

# ============================================
# REMOVE SERVER SIGNATURE
# ============================================
ServerTokens Prod
ServerSignature Off

# ============================================
# ENABLE MOD_REWRITE
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Remove www if present (optional - adjust based on preference)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
    
    # Redirect to HTTPS (uncomment if using HTTPS)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================
# BLOCK BAD BOTS AND SCRAPERS
# ============================================
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider|scraper) [NC]
    RewriteCond %{HTTP_USER_AGENT} !googlebot [NC]
    RewriteCond %{HTTP_USER_AGENT} !(bing|yahoo|yandex) [NC]
    # RewriteRule ^(.*)$ - [F,L]  # Uncomment to block
</IfModule>

# ============================================
# PERFORMANCE TIPS FOR NGINX (If Using Nginx)
# ============================================
# Add this to your Nginx server block if not using Apache:
# 
# gzip on;
# gzip_vary on;
# gzip_min_length 1000;
# gzip_types text/plain text/css text/xml text/javascript
#            application/x-javascript application/xml+rss;
#
# # Expires headers
# location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg)$ {
#     expires 1y;
#     add_header Cache-Control "public, immutable";
# }
#
# location ~* \.(html|htm)$ {
#     expires 2d;
# }

# ============================================
# ADDITIONAL SECURITY HEADERS (if not set by WordPress)
# ============================================
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# ============================================
# NOTES
# ============================================
# 1. WordPress typically handles its own .htaccess
# 2. Add these rules BEFORE WordPress rules if customizing
# 3. Test performance after each change
# 4. Use Google PageSpeed to verify improvements
# 5. For Nginx, add equivalent rules to server block
# 6. Monitor server resources and adjust timeouts if needed
# 7. Consider using a CDN for static assets
